@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h3><i class="fas fa-check-circle me-2"></i>Email Sent</h3>
                </div>
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="fas fa-envelope fa-4x text-success mb-3"></i>
                        <h4>Check Your Email</h4>
                    </div>
                    
                    <p>We've sent a password reset link to your email address.</p>
                    <p>Please check your email and follow the instructions to reset your password.</p>
                    
                    <div class="alert alert-info mt-4">
                        <i class="fas fa-info-circle me-2"></i>
                        <small>If you don't receive an email within a few minutes, please check your spam folder or try again.</small>
                    </div>
                    
                    <div class="mt-4">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-primary">
                            <i class="fas fa-arrow-left me-2"></i>Return to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>