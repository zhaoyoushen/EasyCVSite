@{
    ViewData["Title"] = "Password Reset Confirmation";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h3><i class="fas fa-check-circle me-2"></i>Password Reset Successful</h3>
                </div>
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="fas fa-lock-open fa-4x text-success mb-3"></i>
                        <h4>Your password has been reset</h4>
                    </div>
                    
                    <p>Your password has been successfully reset.</p>
                    <p>You can now use your new password to log in to your account.</p>
                    
                    <div class="mt-4">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-lg">
                            <i class="fas fa-sign-in-alt me-2"></i>Log in now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>