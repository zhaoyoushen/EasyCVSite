@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-user me-2"></i>@Model.UserDisplayName</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a href="#profile" class="list-group-item list-group-item-action active" data-bs-toggle="tab">
                            <i class="fas fa-user-edit me-2"></i>Edit Profile
                        </a>
                        <a href="#themes" class="list-group-item list-group-item-action" data-bs-toggle="tab">
                            <i class="fas fa-palette me-2"></i>Choose Theme
                        </a>
                        <a href="#publish" class="list-group-item list-group-item-action" data-bs-toggle="tab">
                            <i class="fas fa-globe me-2"></i>Publish Settings
                        </a>
                        <a href="#analytics" class="list-group-item list-group-item-action" data-bs-toggle="tab">
                            <i class="fas fa-chart-bar me-2"></i>Analytics
                        </a>
                    </div>
                    
                    <div class="mt-3">
                        @if (Model.IsPublished)
                        {
                            <div class="alert alert-success">
                                <i class="fas fa-check-circle me-2"></i>Published
                            </div>
                            <a href="@Url.Action("Public", "Home", new { url = Model.PublicUrl })" 
                               target="_blank" class="btn btn-outline-primary btn-sm w-100 mb-2">
                                <i class="fas fa-external-link-alt me-2"></i>View Public Page
                            </a>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>Not Published
                            </div>
                        }
                        
                        <form asp-action="Logout" asp-controller="Account" method="post">
                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                                <i class="fas fa-sign-out-alt me-2"></i>Logout
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main Content -->
        <div class="col-md-9">
            <div class="tab-content">
                <!-- Profile Tab -->
                <div class="tab-pane fade show active" id="profile">
                    <div class="card">
                        <div class="card-header">
                            <h4><i class="fas fa-user-edit me-2"></i>Edit Your Profile</h4>
                        </div>
                        <div class="card-body">
                            <form id="profileForm">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h5>Personal Information</h5>
                                        <div class="mb-3">
                                            <label class="form-label">Full Name</label>
                                            <input type="text" class="form-control" id="fullName" value="@Model.UserProfile.PersonalInfo?.Name" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Title</label>
                                            <input type="text" class="form-control" id="title" value="@Model.UserProfile.PersonalInfo?.Title" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Bio</label>
                                            <textarea class="form-control" id="bio" rows="4">@Model.UserProfile.PersonalInfo?.Description</textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Profile Image URL</label>
                                            <input type="url" class="form-control" id="profileImageUrl" value="@Model.UserProfile.PersonalInfo?.ProfileImageUrl" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Welcome Message</label>
                                            <input type="text" class="form-control" id="welcomeMessage" value="@Model.UserProfile.PersonalInfo?.WelcomeMessage" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Highlights (one per line)</label>
                                            <textarea class="form-control" id="highlights" rows="4">@(Model.UserProfile.PersonalInfo?.Highlights != null ? string.Join("\n", Model.UserProfile.PersonalInfo.Highlights) : "")</textarea>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <h5>Contact Information</h5>
                                        <div class="mb-3">
                                            <label class="form-label">Email</label>
                                            <input type="email" class="form-control" id="email" value="@Model.UserProfile.ContactInfo?.Email" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Phone</label>
                                            <input type="tel" class="form-control" id="phone" value="@Model.UserProfile.ContactInfo?.Phone" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Location</label>
                                            <input type="text" class="form-control" id="location" value="@Model.UserProfile.ContactInfo?.Location" />
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <h5>Skills</h5>
                                        <div id="skillsContainer">
                                            @if (Model.UserProfile.Skills != null)
                                            {
                                                @for (int i = 0; i < Model.UserProfile.Skills.Count; i++)
                                                {
                                                    <div class="row mb-2 skill-row">
                                                        <div class="col-md-5">
                                                            <input type="text" class="form-control" placeholder="Skill name" value="@Model.UserProfile.Skills[i].Name" />
                                                        </div>
                                                        <div class="col-md-5">
                                                            <input type="number" class="form-control" placeholder="Proficiency (0-100)" min="0" max="100" value="@Model.UserProfile.Skills[i].Proficiency" />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <button type="button" class="btn btn-outline-danger btn-sm remove-skill">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <button type="button" class="btn btn-outline-primary btn-sm" id="addSkill">
                                            <i class="fas fa-plus me-2"></i>Add Skill
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <h5>Projects</h5>
                                        <div id="projectsContainer">
                                            @if (Model.UserProfile?.Projects != null)
                                            {
                                                @foreach (var project in Model.UserProfile.Projects)
                                                {
                                                    <div class="card mb-3 project-item">
                                                        <div class="card-body">
                                                            <div class="row">
                                                                <div class="col-md-6">
                                                                    <input type="text" class="form-control mb-2 project-name" value="@project.Name" placeholder="Project Name" />
                                                                    <textarea class="form-control mb-2 project-description" rows="2" placeholder="Project Description">@project.Description</textarea>
                                                                    <input type="text" class="form-control mb-2 project-technologies" value="@(project.Technologies != null ? string.Join(", ", project.Technologies) : "")" placeholder="Technologies (comma separated)" />
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <input type="url" class="form-control mb-2 project-demo" value="@project.DemoUrl" placeholder="Demo URL" />
                                                                    <input type="url" class="form-control mb-2 project-source" value="@project.SourceCodeUrl" placeholder="Source Code URL" />
                                                                    <input type="date" class="form-control mb-2 project-date" value="@project.CompletedDate?.ToString("yyyy-MM-dd")" />
                                                                </div>
                                                            </div>
                                                            <button type="button" class="btn btn-outline-danger btn-sm remove-project">
                                                                <i class="fas fa-trash me-2"></i>Remove Project
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <button type="button" class="btn btn-outline-primary btn-sm" id="addProject">
                                            <i class="fas fa-plus me-2"></i>Add Project
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <h5>Work Experience</h5>
                                        <div id="workExperienceContainer">
                                            @if (Model.UserProfile?.WorkExperiences != null)
                                            {
                                                @foreach (var work in Model.UserProfile.WorkExperiences)
                                                {
                                                    <div class="card mb-3 work-item">
                                                        <div class="card-body">
                                                            <div class="row">
                                                                <div class="col-md-6">
                                                                    <input type="text" class="form-control mb-2 work-company" value="@work.Company" placeholder="Company" />
                                                                    <input type="text" class="form-control mb-2 work-position" value="@work.Position" placeholder="Position" />
                                                                    <input type="text" class="form-control mb-2 work-location" value="@work.Location" placeholder="Location" />
                                                                    <input type="url" class="form-control mb-2 work-website" value="@work.CompanyWebsite" placeholder="Company Website" />
                                                                    <input type="url" class="form-control mb-2 work-logo" value="@work.CompanyLogo" placeholder="Company Logo URL" />
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <input type="date" class="form-control mb-2 work-start" value="@work.StartDate?.ToString("yyyy-MM-dd")" placeholder="Start Date" />
                                                                    <input type="date" class="form-control mb-2 work-end" value="@work.EndDate?.ToString("yyyy-MM-dd")" placeholder="End Date" />
                                                                    <div class="form-check mb-2">
                                                                        <input class="form-check-input work-current" type="checkbox" @(work.IsCurrent ? "checked" : "")>
                                                                        <label class="form-check-label">Current Position</label>
                                                                    </div>
                                                                    <input type="text" class="form-control mb-2 work-technologies" value="@(work.Technologies != null ? string.Join(", ", work.Technologies) : "")" placeholder="Technologies (comma separated)" />
                                                                </div>
                                                            </div>
                                                            <textarea class="form-control mb-2 work-description" rows="2" placeholder="Brief Description">@work.Description</textarea>
                                                            <textarea class="form-control mb-2 work-detailed-description" rows="3" placeholder="Detailed Description">@work.DetailedDescription</textarea>
                                                            <textarea class="form-control mb-2 work-responsibilities" rows="2" placeholder="Responsibilities (one per line)">@(work.Responsibilities != null ? string.Join("\n", work.Responsibilities) : "")</textarea>
                                                            <textarea class="form-control mb-2 work-achievements" rows="2" placeholder="Achievements (one per line)">@(work.Achievements != null ? string.Join("\n", work.Achievements) : "")</textarea>
                                                            <button type="button" class="btn btn-outline-danger btn-sm remove-work">
                                                                <i class="fas fa-trash me-2"></i>Remove Work Experience
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <button type="button" class="btn btn-outline-primary btn-sm" id="addWorkExperience">
                                            <i class="fas fa-plus me-2"></i>Add Work Experience
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <h5>Education</h5>
                                        <div id="educationContainer">
                                            @if (Model.UserProfile?.Education != null)
                                            {
                                                @foreach (var education in Model.UserProfile.Education)
                                                {
                                                    <div class="card mb-3 education-item">
                                                        <div class="card-body">
                                                            <div class="row">
                                                                <div class="col-md-6">
                                                                    <input type="text" class="form-control mb-2 education-institution" value="@education.Institution" placeholder="Institution" />
                                                                    <input type="text" class="form-control mb-2 education-degree" value="@education.Degree" placeholder="Degree" />
                                                                    <input type="text" class="form-control mb-2 education-field" value="@education.FieldOfStudy" placeholder="Field of Study" />
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <input type="date" class="form-control mb-2 education-start" value="@education.StartDate?.ToString("yyyy-MM-dd")" placeholder="Start Date" />
                                                                    <input type="date" class="form-control mb-2 education-end" value="@education.EndDate?.ToString("yyyy-MM-dd")" placeholder="End Date" />
                                                                    <input type="text" class="form-control mb-2 education-grade" value="@education.Grade" placeholder="Grade/GPA" />
                                                                </div>
                                                            </div>
                                                            <textarea class="form-control mb-2 education-description" rows="2" placeholder="Description">@education.Description</textarea>
                                                            <button type="button" class="btn btn-outline-danger btn-sm remove-education">
                                                                <i class="fas fa-trash me-2"></i>Remove Education
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <button type="button" class="btn btn-outline-primary btn-sm" id="addEducation">
                                            <i class="fas fa-plus me-2"></i>Add Education
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="mt-4">
                                    <button type="button" class="btn btn-primary" id="saveProfile">
                                        <span id="saveProfileText">
                                            <i class="fas fa-save me-2"></i>Save Profile
                                        </span>
                                        <span id="saveProfileSpinner" class="d-none">
                                            <i class="fas fa-spinner fa-spin me-2"></i>Saving...
                                        </span>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary ms-2" data-bs-toggle="modal" data-bs-target="#importModal">
                                        <i class="fas fa-upload me-2"></i>Import from JSON
                                    </button>
                                    <div id="saveProfileResult" class="mt-2"></div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                
                <!-- Themes Tab -->
                <div class="tab-pane fade" id="themes">
                    <div class="card">
                        <div class="card-header">
                            <h4><i class="fas fa-palette me-2"></i>Choose Your Theme</h4>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                @{
                                    var styles = new[] {
                                        new { Name = "Default", Value = 0, Description = "Standard theme with balanced design and functionality" },
                                        new { Name = "Modern", Value = 1, Description = "Clean and contemporary design with smooth animations" },
                                        new { Name = "Classic", Value = 2, Description = "Traditional and elegant layout with timeless appeal" },
                                        new { Name = "Minimal", Value = 3, Description = "Simple and focused design with plenty of white space" },
                                        new { Name = "Creative", Value = 4, Description = "Bold and artistic with vibrant colors and animations" },
                                        new { Name = "Professional", Value = 5, Description = "Corporate and polished for business presentations" }
                                    };
                                }
                                @foreach (var style in styles)
                                {
                                    <div class="col-md-4 mb-3">
                                        <div class="card theme-card @((int)(Model.UserProfile.Theme?.DisplayStyle ?? 0) == style.Value ? "border-primary" : "")" 
                                             data-theme="@style.Value">
                                            <div class="card-body text-center">
                                                <h5>@style.Name</h5>
                                                <p class="text-muted">@style.Description</p>
                                                <button type="button" class="btn btn-outline-primary btn-sm select-theme" data-theme="@style.Value">
                                                    @((int)(Model.UserProfile.Theme?.DisplayStyle ?? 0) == style.Value ? "Selected" : "Select")
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Publish Tab -->
                <div class="tab-pane fade" id="publish">
                    <div class="card">
                        <div class="card-header">
                            <h4><i class="fas fa-globe me-2"></i>Publish Settings</h4>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h5>Publication Status</h5>
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="publishToggle" @(Model.IsPublished ? "checked" : "")>
                                        <label class="form-check-label" for="publishToggle">
                                            @(Model.IsPublished ? "Published" : "Not Published")
                                        </label>
                                    </div>
                                    
                                    <h5>Custom URL</h5>
                                    <div class="input-group mb-3">
                                        <span class="input-group-text">@(Context.Request.Scheme)://@(Context.Request.Host)/u/</span>
                                        <input type="text" class="form-control" id="customUrl" value="@Model.PublicUrl" placeholder="your-name">
                                        <button class="btn btn-outline-secondary" type="button" id="checkUrl">
                                            <span id="checkUrlText">Check</span>
                                            <i class="fas fa-spinner fa-spin d-none" id="checkUrlSpinner"></i>
                                        </button>
                                    </div>
                                    <div id="urlCheckResult" class="mb-2"></div>
                                    <small class="text-muted">Leave empty to use your user ID as URL</small>
                                    
                                    <div class="mt-3">
                                        <button type="button" class="btn btn-success" id="savePublishSettings">
                                            <span id="saveSettingsText">
                                                <i class="fas fa-save me-2"></i>Save Settings
                                            </span>
                                            <span id="saveSettingsSpinner" class="d-none">
                                                <i class="fas fa-spinner fa-spin me-2"></i>Saving...
                                            </span>
                                        </button>
                                    </div>
                                    <div id="saveSettingsResult" class="mt-2"></div>
                                </div>
                                <div class="col-md-6">
                                    <h5>Preview</h5>
                                    @if (Model.IsPublished)
                                    {
                                        <div class="alert alert-success">
                                            <h6>Your page is live!</h6>
                                            <p>URL: <a href="@(Context.Request.Scheme)://@(Context.Request.Host)/u/@(Model.PublicUrl)" target="_blank">
                                                @(Context.Request.Scheme)://@(Context.Request.Host)/u/@(Model.PublicUrl)
                                            </a></p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            <p>Your page is not published yet. Enable publishing to make it live.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Analytics Tab -->
                <div class="tab-pane fade" id="analytics">
                    <div class="card">
                        <div class="card-header">
                            <h4><i class="fas fa-chart-bar me-2"></i>Analytics</h4>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="card bg-primary text-white">
                                        <div class="card-body text-center">
                                            <h3>@Model.TotalViews</h3>
                                            <p>Total Views</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card bg-success text-white">
                                        <div class="card-body text-center">
                                            <h3>@(Model.IsPublished ? "Live" : "Draft")</h3>
                                            <p>Status</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card bg-info text-white">
                                        <div class="card-body text-center">
                                            <h3>@Model.CreatedAt.ToString("MMM dd")</h3>
                                            <p>Created</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card bg-warning text-white">
                                        <div class="card-body text-center">
                                            <h3>@(Model.LastUpdatedAt?.ToString("MMM dd") ?? "Never")</h3>
                                            <p>Last Updated</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Import Configuration Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importModalLabel">
                    <i class="fas fa-upload me-2"></i>Import Configuration from JSON
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="importForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="configFile" class="form-label">Select JSON Configuration File</label>
                        <input type="file" class="form-control" id="configFile" name="configFile" accept=".json" required>
                        <div class="form-text">Please select a valid JSON file containing your page configuration.</div>
                    </div>
                    <div id="importResult" class="mt-2"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="importSubmitBtn">
                        <span id="importSubmitText">
                            <i class="fas fa-upload me-2"></i>Import Configuration
                        </span>
                        <span id="importSubmitSpinner" class="d-none">
                            <i class="fas fa-spinner fa-spin me-2"></i>Importing...
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .alert-sm {
            padding: 0.5rem 0.75rem;
            margin-bottom: 0.5rem;
            font-size: 0.875rem;
        }
        
        .btn:disabled {
            opacity: 0.6;
        }
        
        #checkUrl:disabled,
        #saveProfile:disabled,
        #savePublishSettings:disabled {
            cursor: not-allowed;
        }
    </style>
    <script>
        $(document).ready(function() {
            // Add skill functionality
            $('#addSkill').click(function() {
                const skillHtml = `
                    <div class="row mb-2 skill-row">
                        <div class="col-md-5">
                            <input type="text" class="form-control" placeholder="Skill name" />
                        </div>
                        <div class="col-md-5">
                            <input type="number" class="form-control" placeholder="Proficiency (0-100)" min="0" max="100" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-skill">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
                $('#skillsContainer').append(skillHtml);
            });
            
            // Remove skill functionality
            $(document).on('click', '.remove-skill', function() {
                $(this).closest('.skill-row').remove();
            });
            
            // Add project functionality
            $('#addProject').click(function() {
                const projectHtml = `
                    <div class="card mb-3 project-item">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <input type="text" class="form-control mb-2 project-name" placeholder="Project Name" />
                                    <textarea class="form-control mb-2 project-description" rows="2" placeholder="Project Description"></textarea>
                                    <input type="text" class="form-control mb-2 project-technologies" placeholder="Technologies (comma separated)" />
                                </div>
                                <div class="col-md-6">
                                    <input type="url" class="form-control mb-2 project-demo" placeholder="Demo URL" />
                                    <input type="url" class="form-control mb-2 project-source" placeholder="Source Code URL" />
                                    <input type="date" class="form-control mb-2 project-date" />
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm remove-project">
                                <i class="fas fa-trash me-2"></i>Remove Project
                            </button>
                        </div>
                    </div>
                `;
                $('#projectsContainer').append(projectHtml);
            });
            
            // Remove project functionality
            $(document).on('click', '.remove-project', function() {
                $(this).closest('.project-item').remove();
            });
            
            // Add education functionality
            $('#addEducation').click(function() {
                const educationHtml = `
                    <div class="card mb-3 education-item">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <input type="text" class="form-control mb-2 education-institution" placeholder="Institution" />
                                    <input type="text" class="form-control mb-2 education-degree" placeholder="Degree" />
                                    <input type="text" class="form-control mb-2 education-field" placeholder="Field of Study" />
                                </div>
                                <div class="col-md-6">
                                    <input type="date" class="form-control mb-2 education-start" placeholder="Start Date" />
                                    <input type="date" class="form-control mb-2 education-end" placeholder="End Date" />
                                    <input type="text" class="form-control mb-2 education-grade" placeholder="Grade/GPA" />
                                </div>
                            </div>
                            <textarea class="form-control mb-2 education-description" rows="2" placeholder="Description"></textarea>
                            <button type="button" class="btn btn-outline-danger btn-sm remove-education">
                                <i class="fas fa-trash me-2"></i>Remove Education
                            </button>
                        </div>
                    </div>
                `;
                $('#educationContainer').append(educationHtml);
            });
            
            // Remove education functionality
            $(document).on('click', '.remove-education', function() {
                $(this).closest('.education-item').remove();
            });
            
            // Add work experience functionality
            $('#addWorkExperience').click(function() {
                const workExperienceHtml = `
                    <div class="card mb-3 work-experience-item">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <input type="text" class="form-control mb-2 work-company" placeholder="Company" />
                                    <input type="text" class="form-control mb-2 work-position" placeholder="Position" />
                                    <input type="text" class="form-control mb-2 work-location" placeholder="Location" />
                                    <input type="url" class="form-control mb-2 work-website" placeholder="Company Website" />
                                    <input type="url" class="form-control mb-2 work-logo" placeholder="Company Logo URL" />
                                </div>
                                <div class="col-md-6">
                                    <input type="date" class="form-control mb-2 work-start" placeholder="Start Date" />
                                    <input type="date" class="form-control mb-2 work-end" placeholder="End Date" />
                                    <div class="form-check mb-2">
                                        <input class="form-check-input work-current" type="checkbox" />
                                        <label class="form-check-label">Currently working here</label>
                                    </div>
                                    <input type="text" class="form-control mb-2 work-technologies" placeholder="Technologies (comma separated)" />
                                </div>
                            </div>
                            <textarea class="form-control mb-2 work-description" rows="2" placeholder="Brief Description"></textarea>
                            <textarea class="form-control mb-2 work-detailed-description" rows="3" placeholder="Detailed Description"></textarea>
                            <textarea class="form-control mb-2 work-responsibilities" rows="2" placeholder="Key Responsibilities"></textarea>
                            <textarea class="form-control mb-2 work-achievements" rows="2" placeholder="Key Achievements"></textarea>
                            <button type="button" class="btn btn-outline-danger btn-sm remove-work-experience">
                                <i class="fas fa-trash me-2"></i>Remove Work Experience
                            </button>
                        </div>
                    </div>
                `;
                $('#workExperienceContainer').append(workExperienceHtml);
            });
            
            // Remove work experience functionality
            $(document).on('click', '.remove-work-experience', function() {
                $(this).closest('.work-experience-item').remove();
            });
            
            // Handle current work checkbox
            $(document).on('change', '.work-current', function() {
                const $endDate = $(this).closest('.work-experience-item').find('.work-end');
                if ($(this).is(':checked')) {
                    $endDate.prop('disabled', true).val('');
                } else {
                    $endDate.prop('disabled', false);
                }
            });
            
            // Theme selection
            $('.select-theme').click(function() {
                const theme = $(this).data('theme');
                $('.theme-card').removeClass('border-primary');
                $(this).closest('.theme-card').addClass('border-primary');
                $('.select-theme').text('Select');
                $(this).text('Selected');
            });
            
            // Save profile
            $('#saveProfile').click(function() {
                const $button = $(this);
                const $text = $('#saveProfileText');
                const $spinner = $('#saveProfileSpinner');
                const $result = $('#saveProfileResult');
                
                // Show loading state
                $button.prop('disabled', true);
                $text.addClass('d-none');
                $spinner.removeClass('d-none');
                $result.empty();
                
                const skills = [];
                $('.skill-row').each(function() {
                    const name = $(this).find('input[type="text"]').val();
                    const proficiency = $(this).find('input[type="number"]').val();
                    if (name && proficiency) {
                        skills.push({ name: name, proficiency: parseInt(proficiency) });
                    }
                });
                
                const projects = [];
                $('.project-item').each(function() {
                    const name = $(this).find('.project-name').val();
                    const description = $(this).find('.project-description').val();
                    const technologies = $(this).find('.project-technologies').val();
                    const demoUrl = $(this).find('.project-demo').val();
                    const sourceCodeUrl = $(this).find('.project-source').val();
                    const completedDate = $(this).find('.project-date').val();
                    
                    if (name) {
                        projects.push({
                            name: name,
                            description: description,
                            technologies: technologies ? technologies.split(',').map(t => t.trim()) : [],
                            demoUrl: demoUrl,
                            sourceCodeUrl: sourceCodeUrl,
                            completedDate: completedDate ? new Date(completedDate).toISOString() : null
                        });
                    }
                });
                
                const education = [];
                $('.education-item').each(function() {
                    const institution = $(this).find('.education-institution').val();
                    const degree = $(this).find('.education-degree').val();
                    const fieldOfStudy = $(this).find('.education-field').val();
                    const startDate = $(this).find('.education-start').val();
                    const endDate = $(this).find('.education-end').val();
                    const grade = $(this).find('.education-grade').val();
                    const description = $(this).find('.education-description').val();
                    
                    if (institution) {
                        education.push({
                            institution: institution,
                            degree: degree,
                            fieldOfStudy: fieldOfStudy,
                            startDate: startDate ? new Date(startDate).toISOString() : null,
                            endDate: endDate ? new Date(endDate).toISOString() : null,
                            grade: grade,
                            description: description
                        });
                    }
                });
                
                const workExperiences = [];
                $('.work-experience-item').each(function() {
                    const company = $(this).find('.work-company').val();
                    const position = $(this).find('.work-position').val();
                    const location = $(this).find('.work-location').val();
                    const companyWebsite = $(this).find('.work-website').val();
                    const companyLogo = $(this).find('.work-logo').val();
                    const startDate = $(this).find('.work-start').val();
                    const endDate = $(this).find('.work-end').val();
                    const isCurrent = $(this).find('.work-current').is(':checked');
                    const technologies = $(this).find('.work-technologies').val();
                    const description = $(this).find('.work-description').val();
                    const detailedDescription = $(this).find('.work-detailed-description').val();
                    const responsibilities = $(this).find('.work-responsibilities').val();
                    const achievements = $(this).find('.work-achievements').val();
                    
                    if (company) {
                        workExperiences.push({
                            company: company,
                            position: position,
                            location: location,
                            companyWebsite: companyWebsite,
                            companyLogo: companyLogo,
                            startDate: startDate ? new Date(startDate).toISOString() : null,
                            endDate: isCurrent ? null : (endDate ? new Date(endDate).toISOString() : null),
                            isCurrent: isCurrent,
                            technologies: technologies ? technologies.split(',').map(t => t.trim()) : [],
                            description: description,
                            detailedDescription: detailedDescription,
                            responsibilities: responsibilities ? responsibilities.split('\n').filter(r => r.trim()) : [],
                            achievements: achievements ? achievements.split('\n').filter(a => a.trim()) : []
                        });
                    }
                });
                
                const config = {
                    personalInfo: {
                        name: $('#fullName').val(),
                        title: $('#title').val(),
                        description: $('#bio').val(),
                        profileImageUrl: $('#profileImageUrl').val(),
                        welcomeMessage: $('#welcomeMessage').val(),
                        highlights: $('#highlights').val() ? $('#highlights').val().split('\n').filter(h => h.trim()) : []
                    },
                    contactInfo: {
                        email: $('#email').val(),
                        phone: $('#phone').val(),
                        location: $('#location').val()
                    },
                    skills: skills,
                    projects: projects,
                    workExperiences: workExperiences,
                    education: education,
                    theme: {
                        displayStyle: parseInt($('.theme-card.border-primary').data('theme')) || 0
                    }
                };
                
                // Debug: Log the workExperiences data
                console.log('WorkExperiences being sent:', workExperiences);
                console.log('Full config object:', config);
                
                $.ajax({
                    url: '@Url.Action("SaveConfiguration", "Dashboard")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(config),
                    success: function(result) {
                        if (result.success) {
                            $result.html('<div class="alert alert-success alert-sm"><i class="fas fa-check-circle me-2"></i>Profile saved successfully!</div>');
                        } else {
                            $result.html('<div class="alert alert-danger alert-sm"><i class="fas fa-times-circle me-2"></i>Error saving profile: ' + result.message + '</div>');
                        }
                    },
                    error: function() {
                        $result.html('<div class="alert alert-danger alert-sm"><i class="fas fa-exclamation-triangle me-2"></i>Error saving profile. Please try again.</div>');
                    },
                    complete: function() {
                        // Reset button state
                        $button.prop('disabled', false);
                        $text.removeClass('d-none');
                        $spinner.addClass('d-none');
                    }
                });
            });
            
            // Import configuration from file upload
            $('#importForm').submit(function(e) {
                e.preventDefault();
                
                const $form = $(this);
                const $button = $('#importSubmitBtn');
                const $text = $('#importSubmitText');
                const $spinner = $('#importSubmitSpinner');
                const $result = $('#importResult');
                const fileInput = $('#configFile')[0];
                
                if (!fileInput.files.length) {
                    $result.html('<div class="alert alert-warning alert-sm"><i class="fas fa-exclamation-triangle me-2"></i>Please select a JSON file to upload.</div>');
                    return;
                }
                
                // Show loading state
                $button.prop('disabled', true);
                $text.addClass('d-none');
                $spinner.removeClass('d-none');
                $result.empty();
                
                const formData = new FormData();
                formData.append('ConfigFile', fileInput.files[0]);
                
                $.ajax({
                    url: '@Url.Action("UploadConfiguration", "Dashboard")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(result) {
                        if (result.success) {
                            $result.html('<div class="alert alert-success alert-sm"><i class="fas fa-check-circle me-2"></i>Configuration imported successfully! Refreshing page...</div>');
                            setTimeout(function() {
                                $('#importModal').modal('hide');
                                location.reload();
                            }, 1500);
                        } else {
                            $result.html('<div class="alert alert-danger alert-sm"><i class="fas fa-times-circle me-2"></i>Error importing configuration: ' + (result.message || 'Unknown error') + '</div>');
                        }
                    },
                    error: function() {
                        $result.html('<div class="alert alert-danger alert-sm"><i class="fas fa-exclamation-triangle me-2"></i>Error importing configuration. Please try again.</div>');
                    },
                    complete: function() {
                        // Reset button state
                        $button.prop('disabled', false);
                        $text.removeClass('d-none');
                        $spinner.addClass('d-none');
                    }
                });
            });
            
            // Clear URL check result when input changes
            $('#customUrl').on('input', function() {
                $('#urlCheckResult').empty();
            });
            
            // Check URL availability
            $('#checkUrl').click(function() {
                const url = $('#customUrl').val();
                const $button = $(this);
                const $text = $('#checkUrlText');
                const $spinner = $('#checkUrlSpinner');
                const $result = $('#urlCheckResult');
                
                if (!url) {
                    $result.html('<div class="alert alert-warning alert-sm"><i class="fas fa-exclamation-triangle me-2"></i>Please enter a URL to check</div>');
                    return;
                }
                
                // Show loading state
                $button.prop('disabled', true);
                $text.addClass('d-none');
                $spinner.removeClass('d-none');
                $result.empty();
                
                $.ajax({
                    url: '@Url.Action("CheckUrlAvailability", "Dashboard")',
                    type: 'POST',
                    data: { url: url },
                    success: function(result) {
                        if (result.available) {
                            $result.html('<div class="alert alert-success alert-sm"><i class="fas fa-check-circle me-2"></i>Great! This URL is available and ready to use.</div>');
                        } else {
                            $result.html('<div class="alert alert-danger alert-sm"><i class="fas fa-times-circle me-2"></i>Sorry, this URL is already taken. Please try a different one.</div>');
                        }
                    },
                    error: function() {
                        $result.html('<div class="alert alert-danger alert-sm"><i class="fas fa-exclamation-triangle me-2"></i>Error checking URL availability. Please try again.</div>');
                    },
                    complete: function() {
                        // Reset button state
                        $button.prop('disabled', false);
                        $text.removeClass('d-none');
                        $spinner.addClass('d-none');
                    }
                });
            });
            
            // Save publish settings
            $('#savePublishSettings').click(function() {
                const isPublished = $('#publishToggle').is(':checked');
                const customUrl = $('#customUrl').val();
                const $button = $(this);
                const $text = $('#saveSettingsText');
                const $spinner = $('#saveSettingsSpinner');
                const $result = $('#saveSettingsResult');
                
                // Show loading state
                $button.prop('disabled', true);
                $text.addClass('d-none');
                $spinner.removeClass('d-none');
                $result.empty();
                
                $.ajax({
                    url: '@Url.Action("UpdatePublishSettings", "Dashboard")',
                    type: 'POST',
                    data: { 
                        isPublished: isPublished,
                        customUrl: customUrl
                    },
                    success: function(result) {
                        if (result.success) {
                            $result.html('<div class="alert alert-success alert-sm"><i class="fas fa-check-circle me-2"></i>Publish settings saved successfully! Refreshing page...</div>');
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            $result.html('<div class="alert alert-danger alert-sm"><i class="fas fa-times-circle me-2"></i>Error saving settings: ' + result.message + '</div>');
                        }
                    },
                    error: function() {
                        $result.html('<div class="alert alert-danger alert-sm"><i class="fas fa-exclamation-triangle me-2"></i>Error saving publish settings. Please try again.</div>');
                    },
                    complete: function() {
                        // Reset button state
                        $button.prop('disabled', false);
                        $text.removeClass('d-none');
                        $spinner.addClass('d-none');
                    }
                });
            });
        });
    </script>
}