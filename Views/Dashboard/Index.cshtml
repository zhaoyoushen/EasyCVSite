@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-user me-2"></i>@Model.UserDisplayName</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a href="#profile" class="list-group-item list-group-item-action active" data-bs-toggle="tab">
                            <i class="fas fa-user-edit me-2"></i>Edit Profile
                        </a>
                        <a href="#themes" class="list-group-item list-group-item-action" data-bs-toggle="tab">
                            <i class="fas fa-palette me-2"></i>Choose Theme
                        </a>
                        <a href="#publish" class="list-group-item list-group-item-action" data-bs-toggle="tab">
                            <i class="fas fa-globe me-2"></i>Publish Settings
                        </a>
                        <a href="#analytics" class="list-group-item list-group-item-action" data-bs-toggle="tab">
                            <i class="fas fa-chart-bar me-2"></i>Analytics
                        </a>
                    </div>
                    
                    <div class="mt-3">
                        @if (Model.IsPublished)
                        {
                            <div class="alert alert-success">
                                <i class="fas fa-check-circle me-2"></i>Published
                            </div>
                            <a href="@Url.Action("Public", "Home", new { url = Model.PublicUrl })" 
                               target="_blank" class="btn btn-outline-primary btn-sm w-100 mb-2">
                                <i class="fas fa-external-link-alt me-2"></i>View Public Page
                            </a>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>Not Published
                            </div>
                        }
                        
                        <form asp-action="Logout" asp-controller="Account" method="post">
                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                                <i class="fas fa-sign-out-alt me-2"></i>Logout
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main Content -->
        <div class="col-md-9">
            <div class="tab-content">
                <!-- Profile Tab -->
                <div class="tab-pane fade show active" id="profile">
                    <div class="card">
                        <div class="card-header">
                            <h4><i class="fas fa-user-edit me-2"></i>Edit Your Profile</h4>
                        </div>
                        <div class="card-body">
                            <form id="profileForm">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h5>Personal Information</h5>
                                        <div class="mb-3">
                                            <label class="form-label">Full Name</label>
                                            <input type="text" class="form-control" id="fullName" value="@Model.UserProfile.PersonalInfo?.Name" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Title</label>
                                            <input type="text" class="form-control" id="title" value="@Model.UserProfile.PersonalInfo?.Title" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Bio</label>
                                            <textarea class="form-control" id="bio" rows="4">@Model.UserProfile.PersonalInfo?.Description</textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Profile Image URL</label>
                                            <input type="url" class="form-control" id="profileImageUrl" value="@Model.UserProfile.PersonalInfo?.ProfileImageUrl" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <h5>Contact Information</h5>
                                        <div class="mb-3">
                                            <label class="form-label">Email</label>
                                            <input type="email" class="form-control" id="email" value="@Model.UserProfile.ContactInfo?.Email" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Phone</label>
                                            <input type="tel" class="form-control" id="phone" value="@Model.UserProfile.ContactInfo?.Phone" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Location</label>
                                            <input type="text" class="form-control" id="location" value="@Model.UserProfile.ContactInfo?.Location" />
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <h5>Skills</h5>
                                        <div id="skillsContainer">
                                            @if (Model.UserProfile.Skills != null)
                                            {
                                                @for (int i = 0; i < Model.UserProfile.Skills.Count; i++)
                                                {
                                                    <div class="row mb-2 skill-row">
                                                        <div class="col-md-5">
                                                            <input type="text" class="form-control" placeholder="Skill name" value="@Model.UserProfile.Skills[i].Name" />
                                                        </div>
                                                        <div class="col-md-5">
                                                            <input type="number" class="form-control" placeholder="Proficiency (0-100)" min="0" max="100" value="@Model.UserProfile.Skills[i].Proficiency" />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <button type="button" class="btn btn-outline-danger btn-sm remove-skill">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <button type="button" class="btn btn-outline-primary btn-sm" id="addSkill">
                                            <i class="fas fa-plus me-2"></i>Add Skill
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <h5>Projects</h5>
                                        <div id="projectsContainer">
                                            @if (Model.UserProfile?.Projects != null)
                                            {
                                                @foreach (var project in Model.UserProfile.Projects)
                                                {
                                                    <div class="card mb-3 project-item">
                                                        <div class="card-body">
                                                            <div class="row">
                                                                <div class="col-md-6">
                                                                    <input type="text" class="form-control mb-2 project-name" value="@project.Name" placeholder="Project Name" />
                                                                    <textarea class="form-control mb-2 project-description" rows="2" placeholder="Project Description">@project.Description</textarea>
                                                                    <input type="text" class="form-control mb-2 project-technologies" value="@(project.Technologies != null ? string.Join(", ", project.Technologies) : "")" placeholder="Technologies (comma separated)" />
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <input type="url" class="form-control mb-2 project-demo" value="@project.DemoUrl" placeholder="Demo URL" />
                                                                    <input type="url" class="form-control mb-2 project-source" value="@project.SourceCodeUrl" placeholder="Source Code URL" />
                                                                    <input type="date" class="form-control mb-2 project-date" value="@project.CompletedDate?.ToString("yyyy-MM-dd")" />
                                                                </div>
                                                            </div>
                                                            <button type="button" class="btn btn-outline-danger btn-sm remove-project">
                                                                <i class="fas fa-trash me-2"></i>Remove Project
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <button type="button" class="btn btn-outline-primary btn-sm" id="addProject">
                                            <i class="fas fa-plus me-2"></i>Add Project
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <h5>Education</h5>
                                        <div id="educationContainer">
                                            @if (Model.UserProfile?.Education != null)
                                            {
                                                @foreach (var education in Model.UserProfile.Education)
                                                {
                                                    <div class="card mb-3 education-item">
                                                        <div class="card-body">
                                                            <div class="row">
                                                                <div class="col-md-6">
                                                                    <input type="text" class="form-control mb-2 education-institution" value="@education.Institution" placeholder="Institution" />
                                                                    <input type="text" class="form-control mb-2 education-degree" value="@education.Degree" placeholder="Degree" />
                                                                    <input type="text" class="form-control mb-2 education-field" value="@education.FieldOfStudy" placeholder="Field of Study" />
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <input type="date" class="form-control mb-2 education-start" value="@education.StartDate?.ToString("yyyy-MM-dd")" placeholder="Start Date" />
                                                                    <input type="date" class="form-control mb-2 education-end" value="@education.EndDate?.ToString("yyyy-MM-dd")" placeholder="End Date" />
                                                                    <input type="text" class="form-control mb-2 education-grade" value="@education.Grade" placeholder="Grade/GPA" />
                                                                </div>
                                                            </div>
                                                            <textarea class="form-control mb-2 education-description" rows="2" placeholder="Description">@education.Description</textarea>
                                                            <button type="button" class="btn btn-outline-danger btn-sm remove-education">
                                                                <i class="fas fa-trash me-2"></i>Remove Education
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <button type="button" class="btn btn-outline-primary btn-sm" id="addEducation">
                                            <i class="fas fa-plus me-2"></i>Add Education
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="mt-4">
                                    <button type="button" class="btn btn-primary" id="saveProfile">
                                        <i class="fas fa-save me-2"></i>Save Profile
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                
                <!-- Themes Tab -->
                <div class="tab-pane fade" id="themes">
                    <div class="card">
                        <div class="card-header">
                            <h4><i class="fas fa-palette me-2"></i>Choose Your Theme</h4>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                @{
                                    var styles = new[] {
                                        new { Name = "Modern", Value = 0, Description = "Clean and contemporary design with smooth animations" },
                                        new { Name = "Classic", Value = 1, Description = "Traditional and elegant layout with timeless appeal" },
                                        new { Name = "Minimal", Value = 2, Description = "Simple and focused design with plenty of white space" },
                                        new { Name = "Creative", Value = 3, Description = "Bold and artistic with vibrant colors and animations" },
                                        new { Name = "Professional", Value = 4, Description = "Corporate and polished for business presentations" }
                                    };
                                }
                                @foreach (var style in styles)
                                {
                                    <div class="col-md-4 mb-3">
                                        <div class="card theme-card @((int)(Model.UserProfile.Theme?.DisplayStyle ?? 0) == style.Value ? "border-primary" : "")" 
                                             data-theme="@style.Value">
                                            <div class="card-body text-center">
                                                <h5>@style.Name</h5>
                                                <p class="text-muted">@style.Description</p>
                                                <button type="button" class="btn btn-outline-primary btn-sm select-theme" data-theme="@style.Value">
                                                    @((int)(Model.UserProfile.Theme?.DisplayStyle ?? 0) == style.Value ? "Selected" : "Select")
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Publish Tab -->
                <div class="tab-pane fade" id="publish">
                    <div class="card">
                        <div class="card-header">
                            <h4><i class="fas fa-globe me-2"></i>Publish Settings</h4>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h5>Publication Status</h5>
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="publishToggle" @(Model.IsPublished ? "checked" : "")>
                                        <label class="form-check-label" for="publishToggle">
                                            @(Model.IsPublished ? "Published" : "Not Published")
                                        </label>
                                    </div>
                                    
                                    <h5>Custom URL</h5>
                                    <div class="input-group mb-3">
                                        <span class="input-group-text">@(Context.Request.Scheme)://@(Context.Request.Host)/u/</span>
                                        <input type="text" class="form-control" id="customUrl" value="@Model.PublicUrl" placeholder="your-name">
                                        <button class="btn btn-outline-secondary" type="button" id="checkUrl">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </div>
                                    <small class="text-muted">Leave empty to use your user ID as URL</small>
                                    
                                    <div class="mt-3">
                                        <button type="button" class="btn btn-success" id="savePublishSettings">
                                            <i class="fas fa-save me-2"></i>Save Settings
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <h5>Preview</h5>
                                    @if (Model.IsPublished)
                                    {
                                        <div class="alert alert-success">
                                            <h6>Your page is live!</h6>
                                            <p>URL: <a href="@Url.Action("Public", "Home", new { url = Model.PublicUrl })" target="_blank">
                                                @(Context.Request.Scheme)://@(Context.Request.Host)/u/@(Model.PublicUrl)
                                            </a></p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            <p>Your page is not published yet. Enable publishing to make it live.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Analytics Tab -->
                <div class="tab-pane fade" id="analytics">
                    <div class="card">
                        <div class="card-header">
                            <h4><i class="fas fa-chart-bar me-2"></i>Analytics</h4>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="card bg-primary text-white">
                                        <div class="card-body text-center">
                                            <h3>@Model.TotalViews</h3>
                                            <p>Total Views</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card bg-success text-white">
                                        <div class="card-body text-center">
                                            <h3>@(Model.IsPublished ? "Live" : "Draft")</h3>
                                            <p>Status</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card bg-info text-white">
                                        <div class="card-body text-center">
                                            <h3>@Model.CreatedAt.ToString("MMM dd")</h3>
                                            <p>Created</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card bg-warning text-white">
                                        <div class="card-body text-center">
                                            <h3>@(Model.LastUpdatedAt?.ToString("MMM dd") ?? "Never")</h3>
                                            <p>Last Updated</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Add skill functionality
            $('#addSkill').click(function() {
                const skillHtml = `
                    <div class="row mb-2 skill-row">
                        <div class="col-md-5">
                            <input type="text" class="form-control" placeholder="Skill name" />
                        </div>
                        <div class="col-md-5">
                            <input type="number" class="form-control" placeholder="Proficiency (0-100)" min="0" max="100" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-skill">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
                $('#skillsContainer').append(skillHtml);
            });
            
            // Remove skill functionality
            $(document).on('click', '.remove-skill', function() {
                $(this).closest('.skill-row').remove();
            });
            
            // Add project functionality
            $('#addProject').click(function() {
                const projectHtml = `
                    <div class="card mb-3 project-item">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <input type="text" class="form-control mb-2 project-name" placeholder="Project Name" />
                                    <textarea class="form-control mb-2 project-description" rows="2" placeholder="Project Description"></textarea>
                                    <input type="text" class="form-control mb-2 project-technologies" placeholder="Technologies (comma separated)" />
                                </div>
                                <div class="col-md-6">
                                    <input type="url" class="form-control mb-2 project-demo" placeholder="Demo URL" />
                                    <input type="url" class="form-control mb-2 project-source" placeholder="Source Code URL" />
                                    <input type="date" class="form-control mb-2 project-date" />
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm remove-project">
                                <i class="fas fa-trash me-2"></i>Remove Project
                            </button>
                        </div>
                    </div>
                `;
                $('#projectsContainer').append(projectHtml);
            });
            
            // Remove project functionality
            $(document).on('click', '.remove-project', function() {
                $(this).closest('.project-item').remove();
            });
            
            // Add education functionality
            $('#addEducation').click(function() {
                const educationHtml = `
                    <div class="card mb-3 education-item">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <input type="text" class="form-control mb-2 education-institution" placeholder="Institution" />
                                    <input type="text" class="form-control mb-2 education-degree" placeholder="Degree" />
                                    <input type="text" class="form-control mb-2 education-field" placeholder="Field of Study" />
                                </div>
                                <div class="col-md-6">
                                    <input type="date" class="form-control mb-2 education-start" placeholder="Start Date" />
                                    <input type="date" class="form-control mb-2 education-end" placeholder="End Date" />
                                    <input type="text" class="form-control mb-2 education-grade" placeholder="Grade/GPA" />
                                </div>
                            </div>
                            <textarea class="form-control mb-2 education-description" rows="2" placeholder="Description"></textarea>
                            <button type="button" class="btn btn-outline-danger btn-sm remove-education">
                                <i class="fas fa-trash me-2"></i>Remove Education
                            </button>
                        </div>
                    </div>
                `;
                $('#educationContainer').append(educationHtml);
            });
            
            // Remove education functionality
            $(document).on('click', '.remove-education', function() {
                $(this).closest('.education-item').remove();
            });
            
            // Theme selection
            $('.select-theme').click(function() {
                const theme = $(this).data('theme');
                $('.theme-card').removeClass('border-primary');
                $(this).closest('.theme-card').addClass('border-primary');
                $('.select-theme').text('Select');
                $(this).text('Selected');
            });
            
            // Save profile
            $('#saveProfile').click(function() {
                const skills = [];
                $('.skill-row').each(function() {
                    const name = $(this).find('input[type="text"]').val();
                    const proficiency = $(this).find('input[type="number"]').val();
                    if (name && proficiency) {
                        skills.push({ name: name, proficiency: parseInt(proficiency) });
                    }
                });
                
                const projects = [];
                $('.project-item').each(function() {
                    const name = $(this).find('.project-name').val();
                    const description = $(this).find('.project-description').val();
                    const technologies = $(this).find('.project-technologies').val();
                    const demoUrl = $(this).find('.project-demo').val();
                    const sourceCodeUrl = $(this).find('.project-source').val();
                    const completedDate = $(this).find('.project-date').val();
                    
                    if (name) {
                        projects.push({
                            name: name,
                            description: description,
                            technologies: technologies ? technologies.split(',').map(t => t.trim()) : [],
                            demoUrl: demoUrl,
                            sourceCodeUrl: sourceCodeUrl,
                            completedDate: completedDate ? new Date(completedDate).toISOString() : null
                        });
                    }
                });
                
                const education = [];
                $('.education-item').each(function() {
                    const institution = $(this).find('.education-institution').val();
                    const degree = $(this).find('.education-degree').val();
                    const fieldOfStudy = $(this).find('.education-field').val();
                    const startDate = $(this).find('.education-start').val();
                    const endDate = $(this).find('.education-end').val();
                    const grade = $(this).find('.education-grade').val();
                    const description = $(this).find('.education-description').val();
                    
                    if (institution) {
                        education.push({
                            institution: institution,
                            degree: degree,
                            fieldOfStudy: fieldOfStudy,
                            startDate: startDate ? new Date(startDate).toISOString() : null,
                            endDate: endDate ? new Date(endDate).toISOString() : null,
                            grade: grade,
                            description: description
                        });
                    }
                });
                
                const config = {
                    personalInfo: {
                        name: $('#fullName').val(),
                        title: $('#title').val(),
                        bio: $('#bio').val(),
                        profileImageUrl: $('#profileImageUrl').val()
                    },
                    contactInfo: {
                        email: $('#email').val(),
                        phone: $('#phone').val(),
                        location: $('#location').val()
                    },
                    skills: skills,
                    projects: projects,
                    education: education,
                    theme: {
                        displayStyle: parseInt($('.theme-card.border-primary').data('theme')) || 0
                    }
                };
                
                $.ajax({
                    url: '@Url.Action("SaveConfiguration", "Dashboard")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(config),
                    success: function(result) {
                        if (result.success) {
                            alert('Profile saved successfully!');
                        } else {
                            alert('Error saving profile: ' + result.message);
                        }
                    },
                    error: function() {
                        alert('Error saving profile.');
                    }
                });
            });
            
            // Check URL availability
            $('#checkUrl').click(function() {
                const url = $('#customUrl').val();
                if (!url) {
                    alert('Please enter a URL');
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("CheckUrlAvailability", "Dashboard")',
                    type: 'POST',
                    data: { url: url },
                    success: function(result) {
                        if (result.available) {
                            alert('URL is available!');
                        } else {
                            alert('URL is not available. Please choose another.');
                        }
                    }
                });
            });
            
            // Save publish settings
            $('#savePublishSettings').click(function() {
                const isPublished = $('#publishToggle').is(':checked');
                const customUrl = $('#customUrl').val();
                
                $.ajax({
                    url: '@Url.Action("UpdatePublishSettings", "Dashboard")',
                    type: 'POST',
                    data: { 
                        isPublished: isPublished,
                        customUrl: customUrl
                    },
                    success: function(result) {
                        if (result.success) {
                            alert('Publish settings saved successfully!');
                            location.reload();
                        } else {
                            alert('Error saving settings: ' + result.message);
                        }
                    }
                });
            });
        });
    </script>
}