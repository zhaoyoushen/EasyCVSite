@{
    ViewData["Title"] = "Personal Homepage Platform";
}

<!-- Hero Section -->
<div class="hero-section bg-gradient text-white py-5">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">Create Your Professional Homepage in Minutes</h1>
                <p class="lead mb-4">Build a stunning personal website to showcase your skills, projects, and achievements. No coding required!</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-lg px-4">
                        <i class="fas fa-rocket me-2"></i>Get Started Free
                    </a>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-outline-light btn-lg px-4">
                        <i class="fas fa-sign-in-alt me-2"></i>Sign In
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="hero-image">
                    <i class="fas fa-laptop-code" style="font-size: 12rem; opacity: 0.8;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="container py-5">
    <div class="row text-center mb-5">
        <div class="col-12">
            <h2 class="display-5 fw-bold mb-3">Why Choose Our Platform?</h2>
            <p class="lead text-muted">Everything you need to create a professional online presence</p>
        </div>
    </div>
    
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-palette fa-3x text-primary"></i>
                    </div>
                    <h5 class="card-title">Multiple Themes</h5>
                    <p class="card-text">Choose from 6 beautiful themes: Default, Modern, Classic, Minimal, Creative, and Professional.</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-link fa-3x text-success"></i>
                    </div>
                    <h5 class="card-title">Custom URLs</h5>
                    <p class="card-text">Get your own personalized URL like yoursite.com/u/yourname for easy sharing.</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-mobile-alt fa-3x text-info"></i>
                    </div>
                    <h5 class="card-title">Mobile Responsive</h5>
                    <p class="card-text">Your homepage looks perfect on all devices - desktop, tablet, and mobile.</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-chart-line fa-3x text-warning"></i>
                    </div>
                    <h5 class="card-title">Analytics</h5>
                    <p class="card-text">Track your homepage views and see how many people are visiting your profile.</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-edit fa-3x text-danger"></i>
                    </div>
                    <h5 class="card-title">Easy Editor</h5>
                    <p class="card-text">User-friendly interface to add your skills, projects, and contact information.</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-rocket fa-3x text-purple"></i>
                    </div>
                    <h5 class="card-title">Instant Publishing</h5>
                    <p class="card-text">Publish your homepage instantly and share it with the world in just one click.</p>
                </div>
            </div>
        </div>
     </div>
</div>

<!-- Call to Action Section -->
<div class="bg-light py-5">
    <div class="container text-center">
        <h3 class="mb-3">Ready to Create Your Professional Homepage?</h3>
        <p class="lead mb-4">Join thousands of professionals who have already created their online presence</p>
        <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-lg px-5">
            <i class="fas fa-user-plus me-2"></i>Create Your Homepage Now
        </a>
    </div>
</div>
