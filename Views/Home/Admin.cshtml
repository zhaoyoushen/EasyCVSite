@model PersonalHomepage.Models.ConfigurationUpload
@{
    ViewData["Title"] = "Configuration Management";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="display-4 fw-bold text-gradient mb-4 text-center">Configuration Management</h1>
            <p class="lead text-center mb-5">Upload JSON configuration files to dynamically update your homepage content</p>
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            
            <!-- Upload Configuration -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-upload me-2"></i>Upload Configuration</h5>
                </div>
                <div class="card-body">
                    <form asp-action="UploadConfiguration" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="ConfigFile" class="form-label">Select JSON Configuration File</label>
                            <input asp-for="ConfigFile" class="form-control" type="file" accept=".json" required>
                            <span asp-validation-for="ConfigFile" class="text-danger"></span>
                            <div class="form-text">Please select a valid JSON file containing your page configuration.</div>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-upload me-2"></i>Upload Configuration
                        </button>
                    </form>
                </div>
            </div>
            
            <!-- Download Current Configuration -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-download me-2"></i>Download Current Configuration</h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">Download the current page configuration as a JSON file for backup or editing.</p>
                    <a href="@Url.Action("DownloadConfiguration")" class="btn btn-success">
                        <i class="fas fa-download me-2"></i>Download Configuration
                    </a>
                </div>
            </div>
            
            <!-- Reset to Default -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-undo me-2"></i>Reset Configuration</h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">Reset the configuration to default settings. This action cannot be undone.</p>
                    <form asp-action="ResetToDefault" method="post" onsubmit="return confirm('Are you sure you want to reset to default configuration? This action cannot be undone.')">
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-undo me-2"></i>Reset to Default
                        </button>
                    </form>
                </div>
            </div>
            
            <!-- Configuration Format Guide -->
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Configuration Format Guide</h5>
                </div>
                <div class="card-body">
                    <p>Your JSON configuration file should follow this structure:</p>
                    <pre class="bg-light p-3 rounded"><code>{
  "personalInfo": {
    "name": "Your Name",
    "title": "Your Title",
    "description": "Your description",
    "profileImageUrl": "https://example.com/image.jpg",
    "welcomeMessage": "Welcome message",
    "highlights": ["Highlight 1", "Highlight 2"]
  },
  "skills": [
    {
      "name": "Skill Name",
      "proficiency": 90
    }
  ],
  "projects": [
    {
      "id": 1,
      "name": "Project Name",
      "description": "Short description",
      "imageUrl": "https://example.com/project.jpg",
      "detailedDescription": "Detailed description",
      "technologies": ["Tech1", "Tech2"],
      "demoUrl": "https://demo.example.com",
      "sourceCodeUrl": "https://github.com/user/repo",
      "completedDate": "2024-01-01T00:00:00"
    }
  ],
  "contactInfo": {
    "email": "your@email.com",
    "phone": "+1234567890",
    "location": "Your Location",
    "socialLinks": [
      {
        "platform": "GitHub",
        "url": "https://github.com/username",
        "icon": "fab fa-github"
      }
    ]
  },
  "theme": {
    "primaryColor": "#007bff",
    "secondaryColor": "#6c757d",
    "backgroundColor": "#ffffff",
    "textColor": "#333333",
    "fontFamily": "'Segoe UI', sans-serif",
    "style": 0
  }
}</code></pre>
                    
                    <div class="alert alert-info mt-3">
                        <h6><i class="fas fa-info-circle"></i> New Features</h6>
                        <ul class="mb-0">
                            <li><strong>Conditional Rendering</strong>: Only modules with content will be displayed, avoiding blank pages</li>
                            <li><strong>Style Selection</strong>: Supports 5 display styles:
                                 <ul>
                                     <li><code>0</code> - Modern Style (Default)</li>
                                     <li><code>1</code> - Classic Style</li>
                                     <li><code>2</code> - Minimal Style</li>
                                     <li><code>3</code> - Creative Style</li>
                                     <li><code>4</code> - Professional Style</li>
                                 </ul>
                             </li>
                            <li><strong>Flexible Configuration</strong>: You can fill in only the fields you need, unfilled modules won't be displayed</li>
                        </ul>
                    </div>
                    
                    <div class="mt-3">
                        <a href="@Url.Action("Index")" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-2"></i>Back to Homepage
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}