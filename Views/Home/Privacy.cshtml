@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center animate-fade-in">
        <div class="col-md-8">
            <h1 class="display-4 fw-bold text-center mb-4 text-gradient">Privacy Policy</h1>
            
            <div class="card shadow-sm animate-fade-in" style="animation-delay: 0.3s;">
                <div class="card-body p-4">
                    <h5 class="mb-3">Information Collection</h5>
                    <p>When you contact me through the contact form on this website, I collect the personal information you provide, including your name, email address, and message content.</p>
                    
                    <h5 class="mb-3 mt-4">Information Usage</h5>
                    <p>The information I collect is used solely to respond to your inquiries or requests. I will not use your personal information for other purposes or share it with third parties.</p>
                    
                    <h5 class="mb-3 mt-4">Information Security</h5>
                    <p>I implement appropriate data collection, storage, and processing practices, as well as security measures to protect your personal information from unauthorized access, alteration, disclosure, or destruction.</p>
                    
                    <h5 class="mb-3 mt-4">Cookie Usage</h5>
                    <p>This website may use cookies to enhance your browsing experience. You can choose to decline cookies, but this may affect your ability to use certain features of the website.</p>
                    
                    <h5 class="mb-3 mt-4">Third-Party Links</h5>
                    <p>This website may contain links to other websites. Please note that I am not responsible for the content or privacy policies of these websites.</p>
                    
                    <h5 class="mb-3 mt-4">Privacy Policy Updates</h5>
                    <p>I may update this privacy policy from time to time. Any changes will be posted on this page.</p>
                    
                    <h5 class="mb-3 mt-4">Contact Me</h5>
                    <p>If you have any questions about this privacy policy, please contact me through the contact form.</p>
                </div>
            </div>
        </div>
    </div>
</div>
