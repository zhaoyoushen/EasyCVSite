@model PageConfiguration
@{
    ViewData["Title"] = Model.PersonalInfo.Name + " - Personal Homepage";
    var displayStyle = Model.Theme.DisplayStyle.ToString().ToLower();
}

<div class="container-fluid p-0" id="mainContent">
    <div class="style-@displayStyle">
        @if (Model.PersonalInfo != null && (!string.IsNullOrEmpty(Model.PersonalInfo.Name) || !string.IsNullOrEmpty(Model.PersonalInfo.Title) || !string.IsNullOrEmpty(Model.PersonalInfo.Description)))
        {
            <!-- Hero Section -->
            <div class="hero-section py-5">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            @if (!string.IsNullOrEmpty(Model.PersonalInfo.Name))
                            {
                                <h1 class="display-4 fw-bold mb-3">@Model.PersonalInfo.Name</h1>
                            }
                            @if (!string.IsNullOrEmpty(Model.PersonalInfo.Title))
                            {
                                <h2 class="h4 text-muted mb-4">@Model.PersonalInfo.Title</h2>
                            }
                            @if (!string.IsNullOrEmpty(Model.PersonalInfo.Description))
                            {
                                <p class="lead mb-4">@Model.PersonalInfo.Description</p>
                            }
                            @if (!string.IsNullOrEmpty(Model.ContactInfo.Email))
                            {
                                <a href="mailto:@Model.ContactInfo.Email" class="btn btn-primary btn-lg me-3">
                                    <i class="fas fa-envelope me-2"></i>Contact Me
                                </a>
                            }
                            @if (Model.ContactInfo.SocialLinks != null && Model.ContactInfo.SocialLinks.Any())
                            {
                                @foreach (var social in Model.ContactInfo.SocialLinks)
                                {
                                    <a href="@social.Url" target="_blank" class="btn btn-outline-secondary me-2">
                                        <i class="@social.Icon me-1"></i>@social.Platform
                                    </a>
                                }
                            }
                        </div>
                        <div class="col-md-6 text-center">
                            @if (!string.IsNullOrEmpty(Model.PersonalInfo.ProfileImageUrl))
                            {
                                <img src="@Model.PersonalInfo.ProfileImageUrl" alt="@Model.PersonalInfo.Name" 
                                     class="img-fluid rounded-circle shadow-lg profile-image" style="max-width: 300px;">
                            }
                            else
                            {
                                <div class="profile-placeholder rounded-circle shadow-lg mx-auto" 
                                     style="width: 300px; height: 300px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-user text-white" style="font-size: 80px;"></i>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.Skills != null && Model.Skills.Any())
        {
            <!-- Skills Section -->
            <div class="skills-section py-5 bg-light">
                <div class="container">
                    <div class="row">
                        <div class="col-12 text-center mb-5">
                            <h2 class="display-5 fw-bold">Skills & Expertise</h2>
                            <p class="lead text-muted">Technologies and tools I work with</p>
                        </div>
                    </div>
                    <div class="row">
                        @foreach (var skill in Model.Skills)
                        {
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 skill-card">
                                    <div class="card-body">
                                        <h5 class="card-title">@skill.Name</h5>
                                        <div class="progress mb-2">
                                            <div class="progress-bar" role="progressbar" style="width: @skill.Proficiency%" 
                                                 aria-valuenow="@skill.Proficiency" aria-valuemin="0" aria-valuemax="100">
                                                @skill.Proficiency%
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.Projects != null && Model.Projects.Any())
        {
            <!-- Projects Section -->
            <div class="projects-section py-5">
                <div class="container">
                    <div class="row">
                        <div class="col-12 text-center mb-5">
                            <h2 class="display-5 fw-bold">Featured Projects</h2>
                            <p class="lead text-muted">Some of my recent work</p>
                        </div>
                    </div>
                    <div class="row">
                        @foreach (var project in Model.Projects)
                        {
                            <div class="col-md-6 col-lg-4 mb-4">
                                <div class="card h-100 project-card">
                                    @if (!string.IsNullOrEmpty(project.ImageUrl))
                                    {
                                        <img src="@project.ImageUrl" class="card-img-top" alt="@project.Name" style="height: 200px; object-fit: cover;">
                                    }
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title">@project.Name</h5>
                                        <p class="card-text flex-grow-1">@project.Description</p>
                                        @if (!string.IsNullOrEmpty(project.DemoUrl))
                                        {
                                            <a href="@project.DemoUrl" target="_blank" class="btn btn-primary mt-auto">
                                                <i class="fas fa-external-link-alt me-2"></i>View Project
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.ContactInfo != null && (!string.IsNullOrEmpty(Model.ContactInfo.Email) || !string.IsNullOrEmpty(Model.ContactInfo.Phone) || !string.IsNullOrEmpty(Model.ContactInfo.Location) || (Model.ContactInfo.SocialLinks != null && Model.ContactInfo.SocialLinks.Any())))
        {
            <!-- Contact Section -->
            <div class="contact-section py-5 bg-dark text-white">
                <div class="container">
                    <div class="row">
                        <div class="col-12 text-center mb-4">
                            <h2 class="display-5 fw-bold">Get In Touch</h2>
                            <p class="lead">Let's connect and discuss opportunities</p>
                        </div>
                    </div>
                    <div class="row justify-content-center">
                        <div class="col-md-8">
                            <div class="row">
                                @if (!string.IsNullOrEmpty(Model.ContactInfo.Email))
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-envelope fa-2x text-primary me-3"></i>
                                            <div>
                                                <h5 class="mb-1">Email</h5>
                                                <a href="mailto:@Model.ContactInfo.Email" class="text-white text-decoration-none">@Model.ContactInfo.Email</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.ContactInfo.Phone))
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-phone fa-2x text-primary me-3"></i>
                                            <div>
                                                <h5 class="mb-1">Phone</h5>
                                                <a href="tel:@Model.ContactInfo.Phone" class="text-white text-decoration-none">@Model.ContactInfo.Phone</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.ContactInfo.Location))
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-map-marker-alt fa-2x text-primary me-3"></i>
                                            <div>
                                                <h5 class="mb-1">Location</h5>
                                                <span>@Model.ContactInfo.Location</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (Model.ContactInfo.SocialLinks != null && Model.ContactInfo.SocialLinks.Any())
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-share-alt fa-2x text-primary me-3"></i>
                                            <div>
                                                <h5 class="mb-1">Social Media</h5>
                                                <div>
                                                    @foreach (var social in Model.ContactInfo.SocialLinks)
                                                    {
                                                        <a href="@social.Url" target="_blank" class="text-white text-decoration-none me-3">
                                                            <i class="@social.Icon me-1"></i>@social.Platform
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Footer -->
        <footer class="bg-light py-3">
            <div class="container text-center">
                <p class="text-muted mb-0">
                    © @DateTime.Now.Year @Model.PersonalInfo.Name. 
                    <span class="text-muted">Powered by Personal Homepage Platform</span>
                </p>
            </div>
        </footer>
    </div>
</div>

<style>
    /* Modern Style (0) - Default */
    .style-modern {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        --primary-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --accent-color: #667eea;
        --border-radius: 12px;
        --shadow: 0 10px 30px rgba(102, 126, 234, 0.1);
    }
    
    .style-modern .hero-section {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
    }
    
    .style-modern .card {
        border-radius: var(--border-radius);
        border: none;
        box-shadow: var(--shadow);
    }
    
    /* Classic Style (1) */
    .style-classic {
        font-family: 'Georgia', serif;
        --primary-color: #8B4513;
        --accent-color: #D2691E;
        --border-radius: 4px;
        --shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
    
    .style-classic .hero-section {
        background: #F5F5DC;
        border-bottom: 3px solid var(--primary-color);
    }
    
    .style-classic .card {
        border: 1px solid #DDD;
        border-radius: var(--border-radius);
    }
    
    /* Minimal Style (2) */
    .style-minimal {
        font-family: 'Helvetica Neue', Arial, sans-serif;
        --primary-color: #000;
        --accent-color: #666;
        --border-radius: 0;
        --shadow: none;
    }
    
    .style-minimal .hero-section {
        background: #FFF;
        border-bottom: 1px solid #EEE;
    }
    
    .style-minimal .card {
        border: 1px solid #EEE;
        border-radius: var(--border-radius);
        box-shadow: var(--shadow);
    }
    
    /* Creative Style (3) */
    .style-creative {
        font-family: 'Comic Sans MS', cursive;
        --primary-color: linear-gradient(45deg, #FF6B6B, #4ECDC4, #45B7D1, #96CEB4, #FFEAA7);
        --accent-color: #FF6B6B;
        --border-radius: 20px;
        --shadow: 0 15px 35px rgba(255, 107, 107, 0.2);
    }
    
    .style-creative .hero-section {
        background: linear-gradient(135deg, #FF6B6B 0%, #4ECDC4 100%);
        color: white;
    }
    
    .style-creative .card {
        border-radius: var(--border-radius);
        border: none;
        box-shadow: var(--shadow);
        animation: pulse 2s infinite;
    }
    
    /* Professional Style (4) */
    .style-professional {
        font-family: 'Arial', sans-serif;
        --primary-color: #2C3E50;
        --accent-color: #3498DB;
        --border-radius: 6px;
        --shadow: 0 4px 12px rgba(44, 62, 80, 0.1);
    }
    
    .style-professional .hero-section {
        background: linear-gradient(135deg, #2C3E50 0%, #3498DB 100%);
        color: white;
    }
    
    .style-professional .card {
        border: 1px solid #BDC3C7;
        border-radius: var(--border-radius);
        box-shadow: var(--shadow);
    }
    
    .style-professional .btn-primary {
        background-color: var(--accent-color);
        border-color: var(--accent-color);
    }
    
    /* Keyframes */
    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.02); }
        100% { transform: scale(1); }
    }
</style>