@model PersonalHomepage.Models.Project
@{
    ViewData["Title"] = Model?.Name ?? "Project Details";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <h1 class="display-4 fw-bold text-gradient mb-4">@Model?.Name</h1>
            
            @if (!string.IsNullOrEmpty(Model?.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow mb-4">
            }
            
            <p class="lead">@Model?.Description</p>
            
            @if (!string.IsNullOrEmpty(Model?.DetailedDescription))
            {
                <div class="mt-4">
                    <h3>Project Details</h3>
                    <p>@Model.DetailedDescription</p>
                </div>
            }
            
            @if (Model?.Technologies != null && Model.Technologies.Any())
            {
                <div class="mt-4">
                    <h4>Technologies Used</h4>
                    <div class="mb-3">
                        @foreach (var tech in Model.Technologies)
                        {
                            <span class="badge bg-primary me-2 mb-2">@tech</span>
                        }
                    </div>
                </div>
            }
            
            @if (Model?.CompletedDate != null)
            {
                <div class="mt-3">
                    <small class="text-muted">Completed: @Model.CompletedDate.Value.ToString("MMMM yyyy")</small>
                </div>
            }
        </div>
        
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Project Links</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model?.DemoUrl))
                    {
                        <a href="@Model.DemoUrl" target="_blank" class="btn btn-success btn-block mb-2 w-100">
                            <i class="fas fa-external-link-alt me-2"></i>Live Demo
                        </a>
                    }
                    
                    @if (!string.IsNullOrEmpty(Model?.SourceCodeUrl))
                    {
                        <a href="@Model.SourceCodeUrl" target="_blank" class="btn btn-dark btn-block mb-2 w-100">
                            <i class="fab fa-github me-2"></i>Source Code
                        </a>
                    }
                    
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary btn-block w-100">
                        <i class="fas fa-arrow-left me-2"></i>Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>